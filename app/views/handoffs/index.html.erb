<div class="page-header">
  <div>
    <h1 class="page-title">Onay Kuyruğu</h1>
    <p class="page-subtitle">Agent devirleri ve insan operatör incelemesi</p>
  </div>
  <span class="status-badge status-on-hold"><%= @handoffs.size %> bekleyen</span>
</div>

<% if @handoffs.empty? %>
  <section class="enterprise-card" style="padding: 1.25rem;">
    <p>İnsan incelemesi bekleyen agent handoff'u yok.</p>
  </section>
<% end %>

<% @handoffs.each do |handoff| %>
  <% resolution = handoff.incident.decisions.resolution.order(created_at: :desc).first %>
  <% output = resolution&.output_json || {} %>
  <section class="enterprise-card" style="margin-bottom: 1rem;">
    <div class="enterprise-card-header">
      <span class="card-title-text">
        <%= link_to "#{handoff.incident.number} · #{handoff.incident.short_description}", incident_path(handoff.incident) %>
      </span>
      <span class="status-badge status-on-hold"><%= handoff.reason_code.humanize %></span>
    </div>
    <div style="padding: 1.25rem;">
      <p><strong>Hedef:</strong> <%= handoff.to_actor_or_group %> · <strong>Güven:</strong> <%= handoff.confidence ? number_to_percentage(handoff.confidence * 100, precision: 0) : "belirtilmedi" %></p>
      <p style="margin: 0.5rem 0;"><strong>Devir özeti:</strong> <%= handoff.brief["agent_reason"] || handoff.reason_code %></p>
      <% if output["steps"].present? %>
        <div style="margin: 0.75rem 0;">
          <strong>Agent çözüm önerisi</strong>
          <ol>
            <% output["steps"].each do |step| %>
              <li><%= step["text"] %></li>
            <% end %>
          </ol>
        </div>
      <% end %>
      <%= form_with url: accept_handoff_path(handoff), method: :post do |form| %>
        <div class="form-group">
          <%= form.label :resolution_notes, "Çözüm notları", class: "form-label" %>
          <%= form.text_area :resolution_notes, value: output.fetch("steps", []).map { |step| step["text"] }.join("\n"), rows: 3, class: "form-textarea", required: true %>
        </div>
        <div class="form-group">
          <%= form.label :root_cause, "Kök neden", class: "form-label" %>
          <%= form.text_area :root_cause, rows: 2, class: "form-textarea", required: true %>
        </div>
        <div class="form-group">
          <%= form.label :verification, "Doğrulama sonucu (KB adayı için)", class: "form-label" %>
          <%= form.text_field :verification, class: "form-input" %>
        </div>
        <div class="form-group">
          <%= form.label :feedback, "Düzeltme / geri bildirim", class: "form-label" %>
          <%= form.text_field :feedback, class: "form-input" %>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <%= form.button "Öneriyi Onayla ve Çöz", name: "review_action", value: "approve", class: "btn btn-success btn-sm" %>
          <%= form.button "Düzelt ve Çöz", name: "review_action", value: "correct", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
      <%= form_with url: reject_handoff_path(handoff), method: :post, style: "margin-top: 0.75rem;" do |form| %>
        <%= form.text_field :feedback, placeholder: "Red nedeni", class: "form-input", aria: { label: "Red nedeni" } %>
        <%= form.submit "Öneriyi Reddet", class: "btn btn-secondary btn-sm", style: "margin-top: 0.5rem;" %>
      <% end %>
    </div>
  </section>
<% end %>
