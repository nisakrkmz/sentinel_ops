<!-- Header & ITSM Action Bar -->
<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--brand-primary); text-transform: uppercase; letter-spacing: 0.05em;">
        ITIL v4 Service Operations
      </span>
      <span style="color: var(--text-dim);">·</span>
      <span style="font-size: 0.75rem; color: var(--text-muted);">Incident Management Workspace</span>
    </div>
    <h1 style="font-size: 1.65rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em;">
      ITSM Incident Management
    </h1>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.2rem;">
      Kurumsal BT altyapı arızalarını yönetin, SLA sürelerini denetleyin ve <strong>Smart Incident Knowledge Matcher</strong> ile geçmiş çözümleri eşleştirin.
    </p>
  </div>

  <div style="display: flex; gap: 0.65rem;">
    <%= link_to new_incident_path, class: "btn btn-primary" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <span>+ Yeni Bilet Aç</span>
    <% end %>
  </div>
</div>

<!-- Kurumsal metrik kartları -->
<div class="metrics-row">
  <div class="metric-card accent-blue">
    <div class="metric-title">
      <span>Toplam Açık Bilet</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-primary)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
    </div>
    <div class="metric-number"><%= @open_count %></div>
    <div class="metric-subtitle">Müdahale veya çözüm bekleyen aktif biletler</div>
  </div>

  <div class="metric-card accent-amber">
    <div class="metric-title">
      <span>İşlemde (In Progress)</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
    </div>
    <div class="metric-number" style="color: #d97706;"><%= @in_progress_count %></div>
    <div class="metric-subtitle">Uzmanlarca aktif incelenen bilet sayısı</div>
  </div>

  <div class="metric-card accent-rose">
    <div class="metric-title">
      <span>SLA İhlalleri (Breached)</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
    </div>
    <div class="metric-number" style="color: #dc2626;"><%= @breached_count %></div>
    <div class="metric-subtitle">Hedef SLA süresi aşılan ve eskalasyon gerektiren</div>
  </div>

  <div class="metric-card accent-purple">
    <div class="metric-title">
      <span>Beklemede</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
    </div>
    <div class="metric-number" style="color: #7c3aed;"><%= @on_hold_count %></div>
    <div class="metric-subtitle">Yanıt veya ek işlem bekleyen biletler</div>
  </div>

  <div class="metric-card accent-emerald">
    <div class="metric-title">
      <span>Çözülen Biletler</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    </div>
    <div class="metric-number" style="color: #16a34a;"><%= @resolved_count %></div>
    <div class="metric-subtitle">Knowledge Base'e eklenmiş arşiv vakalar</div>
  </div>
</div>

<!-- Olay kayıtları tablosu -->
<div class="enterprise-card">
  <div class="enterprise-card-header">
    <div class="card-title-group">
      <span class="card-title-text">ITSM Bilet Listesi</span>
      <span class="card-count_badge card-count-badge"><%= @incidents.count %> Kayıt</span>
      <% if params[:q].present? %>
        <span style="font-size: 0.78rem; color: var(--text-muted);">
          "<%= params[:q] %>" için arama sonuçları · <%= link_to "Temizle", root_path, style: "font-weight: 600;" %>
        </span>
      <% end %>
    </div>

    <!-- Filtre sekmeleri -->
    <div class="filter-tabs">
      <%= link_to "Tümü", root_path, class: "filter-tab #{'active' if @filter == 'all'}" %>
      <%= link_to "Açık Biletler", root_path(filter: "open"), class: "filter-tab #{'active' if @filter == 'open'}" %>
      <%= link_to "İşlemde", root_path(filter: "in_progress"), class: "filter-tab #{'active' if @filter == 'in_progress'}" %>
      <%= link_to "Beklemede", root_path(filter: "on_hold"), class: "filter-tab #{'active' if @filter == 'on_hold'}" %>
      <%= link_to "P1 Kritik", root_path(filter: "p1"), class: "filter-tab #{'active' if @filter == 'p1'}" %>
      <%= link_to "SLA İhlalleri", root_path(filter: "breached"), class: "filter-tab #{'active' if @filter == 'breached'}" %>
      <%= link_to "Çözülmüş (KB)", root_path(filter: "resolved"), class: "filter-tab #{'active' if @filter == 'resolved'}" %>
    </div>
  </div>

  <% if @incidents.any? %>
    <table class="itsm-table">
      <thead>
        <tr>
          <th>Bilet No</th>
          <th>Öncelik</th>
          <th>Durum</th>
          <th>Kısa Açıklama</th>
          <th>Etkilenen Servis</th>
          <th>Talep Eden (Caller)</th>
          <th>SLA Durumu</th>
          <th>Atanan Grup / Kişi</th>
          <th style="text-align: right;">İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% @incidents.each do |incident| %>
          <tr>
            <td>
              <%= link_to incident_path(incident), class: "ticket-number-badge" do %>
                <%= incident.number %>
              <% end %>
            </td>
            <td>
              <% priority_class = case incident.priority
                                  when "p1_critical" then "badge-p1"
                                  when "p2_high" then "badge-p2"
                                  when "p3_moderate" then "badge-p3"
                                  else "badge-p4"
                                  end %>
              <span class="badge <%= priority_class %>">
                <%= incident.priority_short_label %>
              </span>
            </td>
            <td>
              <% state_class = case incident.state
                               when "new_ticket" then "badge-new"
                               when "in_progress" then "badge-in-progress"
                               when "on_hold" then "badge-on-hold"
                               when "resolved" then "badge-resolved"
                               else "badge-new"
                               end %>
              <span class="badge <%= state_class %>">
                <%= incident.state_label.split(" ").first %>
              </span>
            </td>
            <td style="max-width: 320px;">
              <%= link_to incident_path(incident), style: "font-weight: 600; color: var(--text-primary); display: block;" do %>
                <%= incident.short_description %>
              <% end %>
              <span style="font-size: 0.74rem; color: var(--text-dim); display: block; margin-top: 0.15rem;">
                Açılış: <%= l(incident.created_at, format: :short) %> · Kat: <%= incident.category %>
              </span>
            </td>
            <td>
              <span class="service-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                <%= incident.service_affected %>
              </span>
            </td>
            <td>
              <span style="font-weight: 500; color: var(--text-secondary); font-size: 0.82rem;">
                <%= incident.requested_by %>
              </span>
            </td>
            <td>
              <% if incident.resolved? %>
                <span class="badge badge-within-sla">
                  ✓ Çözüldü
                </span>
              <% elsif incident.sla_breached? %>
                <span class="badge badge-sla-breached">
                  ⚠ SLA Breached
                </span>
              <% else %>
                <% rem = incident.sla_time_remaining_seconds %>
                <span class="badge badge-within-sla" style="font-family: var(--font-mono); font-size: 0.78rem;">
                  ⏱ <%= "%02d:%02d" % [rem / 60, rem % 60] %>
                </span>
              <% end %>
            </td>
            <td>
              <span style="font-size: 0.78rem; color: var(--text-secondary); display: block;">
                <%= incident.assignment_group %>
              </span>
              <span style="font-size: 0.72rem; color: var(--text-dim);">
                <%= incident.assigned_to %>
              </span>
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <%= link_to incident_path(incident), class: "btn btn-secondary btn-sm" do %>
                <span>Detay</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div style="padding: 3rem 2rem; text-align: center; color: var(--text-muted);">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" style="margin-bottom: 0.75rem;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-secondary);">Kayıt Bulunamadı</h3>
      <p style="font-size: 0.85rem; margin-top: 0.25rem;">Seçilen filtre kriterlerine uygun açık veya geçmiş bilet bulunmuyor.</p>
    </div>
  <% end %>
</div>

<!-- Alt Bölüm: 100 Puanlık Acı Noktası (Knowledge Base & Incident Memory Bilgilendirmesi) -->
<div style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div style="display: flex; align-items: center; gap: 1rem;">
    <div style="width: 40px; height: 40px; border-radius: 8px; background: #eef2ff; display: flex; align-items: center; justify-content: center; color: #4f46e5;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
    </div>
    <div>
      <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">
        Smart Incident Knowledge Matcher (Geçmiş Olay Hafızası) Aktif
      </h4>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem;">
        Bilet açıldığında benzer çözülmüş olaylar aranır; bulunan çözüm notları tek adımda uygulanabilir.
      </p>
    </div>
  </div>

  <%= link_to root_path(filter: "resolved"), class: "btn btn-secondary btn-sm" do %>
    <span>Geçmiş Çözülmüş Biletleri İncele (<%= @resolved_count %>)</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
  <% end %>
</div>
