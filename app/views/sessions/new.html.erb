<section class="login-layout" aria-labelledby="login-title">
  <%= render "sessions/story" %>

  <div class="login-form-side">
    <div class="login-card">
      <span class="login-card-eyebrow">OPERATÖR ERİŞİMİ</span>
      <h2 id="login-title">Tekrar hoş geldin</h2>
      <p class="login-intro">Workspace'e devam etmek için hesabınla giriş yap.</p>

      <% if flash.now[:alert].present? %>
        <div class="flash-message flash-alert login-alert" role="alert"><%= flash.now[:alert] %></div>
      <% end %>

      <%= form_with url: login_path, method: :post, local: true, class: "login-form", data: { login_form: true } do |form| %>
        <div class="login-field">
          <%= form.label :email, "E-posta" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
            </svg>
            <%= form.email_field :email, value: params[:email], autocomplete: "username", autocapitalize: "none", spellcheck: false, required: true, autofocus: true, placeholder: "ornek@sirket.com" %>
          </div>
        </div>

        <div class="login-field">
          <%= form.label :password, "Şifre" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/>
            </svg>
            <%= form.password_field :password, autocomplete: "current-password", required: true %>
          </div>
        </div>

        <%= form.submit "Güvenli giriş yap", class: "login-submit" %>
      <% end %>

      <% if (demo = User.demo_operator) %>
        <div class="login-demo-box" role="note">
          <div>
            <strong>Demo hesabı</strong>
            <small><code><%= demo[:email] %></code> · <code><%= demo[:password] %></code></small>
          </div>
          <button type="button" class="login-demo-fill" data-demo-email="<%= demo[:email] %>" data-demo-password="<%= demo[:password] %>">Bilgileri doldur</button>
        </div>
      <% end %>

      <p class="login-switch">Hesabın yok mu? <%= link_to "Kayıt ol", signup_path %></p>
    </div>
    <p class="login-help">Oturum denemeleri IP başına sınırlandırılır; şifreler veritabanında yalnızca hash olarak saklanır.</p>
  </div>
</section>
