<section class="login-layout" aria-labelledby="login-title">
  <div class="login-story">
    <%= link_to login_path, class: "login-brand", aria: { label: "SentinelOps giriş sayfası" } do %>
      <span class="login-brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </span>
      <span><strong>SentinelOps</strong><small>ITSM ENTERPRISE</small></span>
    <% end %>

    <div class="login-story-copy">
      <span class="login-eyebrow"><span></span> SERVICE OPERATIONS WORKSPACE</span>
      <h1>Olayları daha net görün.<br><span>Kontrol sizde kalsın.</span></h1>
      <p>Incident, SLA ve agent kararlarını tek bir güvenli operasyon ekranından yönetin.</p>
    </div>

    <div class="login-trust-note">
      <span class="login-trust-icon" aria-hidden="true">✓</span>
      <span><strong>Güvenli operatör oturumu</strong><small>Denetim izindeki aksiyonlar Nisa ile ilişkilendirilir.</small></span>
    </div>
    <span class="login-version">ITIL v4 · INCIDENT MANAGEMENT</span>
  </div>

  <div class="login-form-side">
    <div class="login-card">
      <span class="login-card-eyebrow">OPERATÖR ERİŞİMİ</span>
      <h2 id="login-title">Tekrar hoş geldin, Nisa</h2>
      <p class="login-intro">Workspace'e devam etmek için hesabınla giriş yap.</p>

      <% if flash.now[:alert].present? %>
        <div class="flash-message flash-alert login-alert" role="alert"><%= flash.now[:alert] %></div>
      <% end %>

      <% unless @password_configured %>
        <div class="login-config-warning" role="status">
          <strong>Giriş henüz yapılandırılmadı</strong>
          <span>Yönetici, sunucu ortamında en az 12 karakterlik <code>NISA_PASSWORD</code> ayarlamalı.</span>
        </div>
      <% end %>

      <%= form_with url: login_path, method: :post, local: true, class: "login-form" do |form| %>
        <div class="login-field">
          <%= form.label :username, "Kullanıcı adı" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="8" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
            </svg>
            <%= form.text_field :username, value: "Nisa", autocomplete: "username", autocapitalize: "none", spellcheck: false, required: true, autofocus: true %>
          </div>
        </div>

        <div class="login-field">
          <%= form.label :password, "Şifre" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/>
            </svg>
            <%= form.password_field :password, autocomplete: "current-password", required: true, disabled: !@password_configured %>
          </div>
        </div>

        <%= form.submit "Güvenli giriş yap", class: "login-submit", disabled: !@password_configured %>
      <% end %>

      <div class="login-security-note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Oturum denemeleri güvenli şekilde sınırlandırılır.</span>
      </div>
    </div>
    <p class="login-help">Erişim sorunu mu yaşıyorsun? Sistem yöneticinle iletişime geç.</p>
  </div>
</section>
