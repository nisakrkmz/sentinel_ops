<%# Page Agent Copilot başlatıcısı (sağ alt). Tıklanınca Alibaba page-agent'ın orijinal
    paneli (alt ortadaki görev çubuğu) ve ekranda hareket eden imleç kullanılır.
    data-turbo-permanent: sayfa geçişlerinde başlatıcı ve durum korunur. %>
<div id="sentinel-copilot" class="copilot" data-turbo-permanent data-copilot
     data-copilot-enabled="<%= PageAgentProxy.configured? %>" data-state="closed">
  <button type="button" class="copilot-fab" data-copilot-toggle aria-expanded="false"
          aria-label="<%= PageAgentProxy.configured? ? 'Page Agent Copilot' : 'Page Agent Copilot · Provider beklemede' %>"
          title="<%= PageAgentProxy.configured? ? 'Page Agent Copilot' : 'Sunucuda Page Agent sağlayıcısı yapılandırılmadı' %>"
          <%= "disabled" unless PageAgentProxy.configured? %>>
    <span class="copilot-fab-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 3v4"/><circle cx="9" cy="13" r="1.2"/><circle cx="15" cy="13" r="1.2"/></svg>
    </span>
    <span class="copilot-fab-label"><%= PageAgentProxy.configured? ? "Page Agent Copilot" : "Page Agent · beklemede" %></span>
    <span class="copilot-fab-pulse" aria-hidden="true"></span>
  </button>
</div>
