<section class="login-layout" aria-labelledby="signup-title">
  <%= render "sessions/story" %>

  <div class="login-form-side">
    <div class="login-card">
      <span class="login-card-eyebrow">YENİ OPERATÖR</span>
      <h2 id="signup-title">Hesap oluştur</h2>
      <p class="login-intro">Ekibine katıl; bilet, onay ve agent kararlarını kendi kimliğinle yönet.</p>

      <% if flash.now[:alert].present? %>
        <div class="flash-message flash-alert login-alert" role="alert"><%= flash.now[:alert] %></div>
      <% end %>

      <% if @user.errors.any? %>
        <div class="flash-message flash-alert login-alert" role="alert">
          <ul class="login-errors">
            <% @user.errors.map(&:message).uniq.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: signup_path, method: :post, local: true, class: "login-form" do |form| %>
        <div class="login-field">
          <%= form.label :name, "Ad Soyad" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="8" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/>
            </svg>
            <%= form.text_field :name, autocomplete: "name", required: true, maxlength: 60, autofocus: true %>
          </div>
        </div>

        <div class="login-field">
          <%= form.label :email, "E-posta" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
            </svg>
            <%= form.email_field :email, autocomplete: "email", autocapitalize: "none", spellcheck: false, required: true %>
          </div>
        </div>

        <div class="login-field">
          <%= form.label :password, "Şifre (en az #{User::MINIMUM_PASSWORD_LENGTH} karakter)" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
            </svg>
            <%= form.password_field :password, autocomplete: "new-password", required: true, minlength: User::MINIMUM_PASSWORD_LENGTH %>
          </div>
        </div>

        <div class="login-field">
          <%= form.label :password_confirmation, "Şifre (tekrar)" %>
          <div class="login-input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="m9 16 2 2 4-4"/>
            </svg>
            <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true %>
          </div>
        </div>

        <%= form.submit "Hesabı oluştur", class: "login-submit" %>
      <% end %>

      <p class="login-switch">Zaten hesabın var mı? <%= link_to "Giriş yap", login_path %></p>
    </div>
  </div>
</section>
