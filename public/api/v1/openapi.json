{
  "openapi": "3.1.0",
  "info": {
    "title": "SentinelOps Agent API",
    "version": "1.0.0",
    "description": "Scoped REST API for agent-accessible incident management and approved knowledge search."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "security": [
    { "BearerToken": [] }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "summary": "Call the MCP JSON-RPC endpoint",
        "description": "Requires a bearer token. Each tool call separately checks the corresponding actor scope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["jsonrpc", "id", "method"],
                "properties": {
                  "jsonrpc": { "const": "2.0" },
                  "id": { "type": ["string", "integer"] },
                  "method": { "type": "string", "enum": ["initialize", "ping", "tools/list", "tools/call"] },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "/events": {
          "get": {
            "summary": "Read the incident event stream",
            "description": "Requires the events:read scope. Returns an SSE event batch; reconnect with Last-Event-ID to continue.",
            "security": [{ "BearerToken": [] }],
            "parameters": [
              { "name": "Last-Event-ID", "in": "header", "schema": { "type": "integer", "minimum": 0 } }
            ],
            "responses": {
              "200": { "description": "Server-sent event batch.", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
              "400": { "$ref": "#/components/responses/ApiError" }
            }
          }
        },
        "responses": { "200": { "description": "JSON-RPC response." }, "401": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/incidents": {
      "get": {
        "summary": "List incidents",
        "description": "Requires the incidents:read scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["new_ticket", "in_progress", "on_hold", "resolved", "closed"] } },
          { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] } },
          { "name": "service", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
        ],
        "responses": {
          "200": { "description": "Incident page and an optional next cursor." },
          "400": { "$ref": "#/components/responses/ApiError" }
        }
      },
      "post": {
        "summary": "Open and triage an incident",
        "description": "Requires the incidents:create scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 255 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["short_description", "service_affected"],
                "properties": {
                  "short_description": { "type": "string" },
                  "description": { "type": "string" },
                  "service_affected": { "type": "string" },
                  "category": { "type": "string" },
                  "requested_by": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Incident created; triage may be pending." },
          "200": { "description": "Idempotent replay of an identical request." },
          "400": { "$ref": "#/components/responses/ApiError" },
          "409": { "$ref": "#/components/responses/ApiError" },
          "422": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/incidents/{id}": {
      "get": {
        "summary": "Get an incident",
        "description": "Requires the incidents:read scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "responses": {
          "200": { "description": "Incident details and latest triage provenance." },
          "404": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/incidents/{id}/comments": {
      "post": {
        "summary": "Add an incident comment",
        "description": "Requires the incidents:comment scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["content"], "properties": { "content": { "type": "string", "maxLength": 5000 } } } } }
        },
        "responses": { "201": { "description": "Comment created." }, "403": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/incidents/{id}/claim": {
      "post": {
        "summary": "Claim an unassigned incident",
        "description": "Requires the incidents:claim scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "responses": { "200": { "description": "Incident claimed." }, "409": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/incidents/{id}/resolve": {
      "post": {
        "summary": "Resolve an incident",
        "description": "Requires the incidents:resolve scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resolution_notes", "root_cause", "citations"],
                "properties": {
                  "resolution_notes": { "type": "string" },
                  "root_cause": { "type": "string" },
                  "verification": { "type": "string" },
                  "citations": { "type": "array", "items": { "type": "string" }, "maxItems": 50 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Incident resolved; optional verified resolution is queued for human KB approval." }, "409": { "$ref": "#/components/responses/ApiError" }, "422": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/incidents/{id}/handoff": {
      "post": {
        "summary": "Hand off an incident",
        "description": "Requires the handoff:create scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason_code", "to_actor_or_group", "brief"],
                "properties": {
                  "reason_code": { "type": "string" },
                  "to_actor_or_group": { "type": "string" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "brief": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Handoff opened and incident marked for human review." }, "422": { "$ref": "#/components/responses/ApiError" } }
      }
    },
    "/kb/search": {
      "get": {
        "summary": "Search approved knowledge chunks",
        "description": "Requires the kb:read scope.",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Semantically ranked, cited knowledge chunks." }, "503": { "$ref": "#/components/responses/ApiError" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque agent token"
      }
    },
    "parameters": {
      "IncidentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "description": "Incident database ID or incident number." }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Machine-readable API error.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["code", "message", "retryable", "field_errors"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" },
                "field_errors": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
